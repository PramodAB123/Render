# Copy this file to ".env" (same folder) and paste your free keys after the = signs.
# Never share .env or the secrets folder with anyone.

# Google Cloud Console > APIs & Services > Credentials > Create credentials > API key
# (with "YouTube Data API v3" enabled). Used for finding trending ideas.
YOUTUBE_API_KEY=

# https://www.pexels.com/api/  (free account > "Your API key")
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  (free account, key shown on that page when logged in)
PIXABAY_API_KEY=

# Uploading uses OAuth instead of a key: put the downloaded file at secrets\client_secret.json
